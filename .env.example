# FlameAnalyzer - example environment configuration
#
# Copy to `.env` and load it with your process manager / deployment platform.
# The application reads these variables directly from the environment; it does
# not parse .env files itself.
#
# Every value below is a SAFE PLACEHOLDER. There are no secrets in this
# project: the API is unauthenticated for internal testing and no tokens,
# API keys or passwords are required to run it.

# --- Model weights -------------------------------------------------------
# Optional convenience: directory holding both weight files. Defaults to the
# bundled ./models directory.
FLAME_MODEL_DIR=

# Individual overrides; both win over FLAME_MODEL_DIR when set.
FLAME_DET_MODEL=models/OBJ_best.pt
FLAME_SEG_MODEL=models/SEG_best.pt

# --- Material database ---------------------------------------------------
# The dataset variable in this codebase is FLAME_DATASET (not
# FLAME_DATASET_PATH). Defaults to the bundled ./data/flame_dataset.json.
FLAME_DATASET=data/flame_dataset.json

# --- Device --------------------------------------------------------------
# Leave empty for automatic selection: CUDA when available, otherwise CPU.
# Examples: "0" (first GPU), "cpu", "mps".
FLAME_DEVICE=

# --- Inference parameters ------------------------------------------------
FLAME_IMGSZ=640
FLAME_DET_CONF=0.4
FLAME_SEG_CONF=0.4
FLAME_DET_CLASS=0

# How `k` is chosen for the k-based clustering algorithms.
#   silhouette - search k in [FLAME_N_CLUSTERS, FLAME_K_MAX] and cap the
#                 winner at FLAME_K_CAP (default, restored from the original)
#   fixed      - always use FLAME_N_CLUSTERS
FLAME_K_SELECTION=silhouette
FLAME_N_CLUSTERS=2
FLAME_K_MAX=6
FLAME_K_CAP=4
FLAME_SILHOUETTE_SAMPLES=300

# Sampling and per-algorithm iteration limits.
FLAME_MAX_PIXELS=2000
FLAME_MIN_PIXELS=10
FLAME_KMEANS_NINIT=10
FLAME_GMM_MAX_ITER=100
FLAME_BGGMM_MAX_ITER=50
# Variance floor for the variational Bayesian GMM. scikit-learn's 1e-6 raises
# on ill-defined covariances, which happens on tightly separated flame tones.
FLAME_BGGMM_REG_COVAR=0.001

# DBSCAN. `FLAME_DBSCAN_EPS` is in standardised (StandardScaler) units, not
# CIELAB units. min_samples = max(FLAME_DBSCAN_MIN_SAMPLES, n / DIV).
FLAME_DBSCAN_EPS=0.5
FLAME_DBSCAN_MIN_SAMPLES=3
FLAME_DBSCAN_MIN_SAMPLES_DIV=50

# Set to 0 to omit the base64 PNG mask from the response and keep the payload
# small when only the segmentation statistics are needed.
FLAME_EMIT_MASK=1
FLAME_MASK_PNG_COMPRESSION=6

FLAME_MAX_ALTERNATIVES=3
FLAME_SIM_SCALE=200.0
FLAME_SEED=42

# --- HTTP API ------------------------------------------------------------
# Maximum accepted upload size, in mebibytes. Larger uploads are rejected
# with HTTP 413 before any inference runs.
FLAME_MAX_IMAGE_MB=10

# Comma-separated browser origins allowed by CORS. Leave empty to disable
# CORS entirely (the default, and correct for server-to-server calls).
# Example for a local Vite dev server:
# FLAME_CORS_ORIGINS=http://localhost:5173
# A wildcard ("*") is allowed but never combined with credentials.
FLAME_CORS_ORIGINS=

# --- Logging -------------------------------------------------------------
# Set to 1 to let the backend log model loading and analysis progress.
# It only ever logs sizes, timings and error codes - never image contents.
FLAME_YOLO_VERBOSE=0

# --- AI material analysis (secondary, Gemini-powered) ---------------------
# Optional secondary opinion on the burning material. When disabled (the
# default) the response carries
#   "ai_material_analysis": {"available": false, "error": "... disabled ..."}
# and the deterministic FlameAnalyzer result is completely unaffected.
#
# Master switch. Set to 1 to enable the secondary analysis.
GEMINI_ENABLED=0
# API key for the Gemini API. Never hardcoded, never logged, never returned
# to the frontend. When GEMINI_ENABLED=1 and this is empty, the AI analysis
# reports {"available": false, "error": "GEMINI_API_KEY is not configured."}.
GEMINI_API_KEY=
# Model used for the secondary analysis.
GEMINI_MODEL=gemini-3.5-flash-lite
# Hard timeout (seconds) for one Gemini request. A slow request is abandoned
# and reported as unavailable; it never blocks /analyze indefinitely.
GEMINI_TIMEOUT_S=30
